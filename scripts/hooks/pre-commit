#!/bin/bash
# ols-qa pre-commit — THIS REPO IS PUBLIC.
#
# Guards EVERY staged text file, not just the ones shared with helix. The old version
# exempted non-shared paths (references/ols-project-guide.md etc.) on the assumption that
# this workspace was a private vault for OLS config. That assumption died when the repo
# was made public on 2026-06-11 — the exemption is what let credentials, internal hosts and
# resource ids reach GitHub. Real values now live in ~/.ols-qa-secrets/ols-secrets.md,
# outside the repo, and repo docs carry placeholders only.
#
# Fails CLOSED: a missing or erroring scanner blocks the commit.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
GUARD="$ROOT/scripts/check-no-secrets.sh"

# ── the tree this commit will produce ────────────────────────────────────────────
#
# Everything below judges the INDEX, never the working tree, and `git checkout-index -a`
# materialises it once for both consumers. Extracting only the changed blobs one at a time
# was wrong twice over:
#
#   * `git show ":$f" > "$TMP/$f" || continue` created the target BEFORE git ran, so a
#     failed extraction left a 0-byte stand-in that the scanner then read as clean. It
#     fails for real: `core.quotePath` defaults to true, so a staged `หลักฐาน.md` arrives
#     C-quoted, `git show ":<that>"` exits 128, and a file carrying a live credential was
#     handed to the guard as empty. Measured 2026-09-06.
#   * the report validator was never given the snapshot at all and read the folder off
#     disk, so a half-staged report passed whenever the worktree copy was intact.
#
# One extract, one truth, and it is the truth that is about to be committed. It costs about
# a third of a second on this repo (219 files) — measured, not assumed.
SNAP="$(mktemp -d)"
trap 'rm -rf "$SNAP"' EXIT
if ! git checkout-index -a --prefix="$SNAP/" 2>/dev/null; then
  echo "[ols-qa pre-commit] ❌ commit BLOCKED — could not materialise the staged tree."
  echo "  ตรวจสอบไม่ได้ว่าอะไรกำลังจะถูกคอมมิต จึงไม่ปล่อยผ่าน"
  exit 1
fi

# Two lists, because they answer two different questions.
#
# ALL_STAGED is every path this commit touches, deletions included, and it decides which
# GATES apply. Using the scan list for that was a hole: `--diff-filter=ACM` drops D, so a
# commit that only deleted files produced an empty list and the hook exited at the check
# below — fifty lines above the debt gate. A commit staging only a screenshot did the same.
ALL_STAGED=()
while IFS= read -r -d '' f; do
  [ -n "$f" ] || continue
  ALL_STAGED+=("$f")
done < <(git diff --cached --name-only -z)

# STAGED is the text blobs the secret scanner reads — present in the index, not binary.
STAGED=()
while IFS= read -r -d '' f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webm|*.mp4|*.pdf|*.zip|*.csv) continue ;;
  esac
  STAGED+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ ! -x "$GUARD" ]; then
  echo "[ols-qa pre-commit] ❌ secret guard missing or not executable: $GUARD"
  echo "  Restore it (chmod +x). Commit BLOCKED (fail-closed) — this repo is public."
  exit 1
fi

if [ "${#STAGED[@]}" -gt 0 ]; then
  echo "[ols-qa pre-commit] scanning ${#STAGED[@]} staged file(s) for OLS secrets…"
  SCAN_ROOT="$SNAP" "$GUARD" "${STAGED[@]}"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "[ols-qa pre-commit] ❌ commit BLOCKED (guard exit $rc)."
    echo "  Use the placeholder instead of the real value. Mapping:"
    echo "    ~/.ols-qa-secrets/ols-secrets.md"
    exit 1
  fi
fi

# ── Post-mortem debt gate — layer 8 of ten ───────────────────────────────────────
#
# While a mistake is on the ledger with no report, new work does not ship past it. The
# reminder layers (session start, every prompt, every turn end, compaction) can be read
# past; this one cannot. There is no override flag on purpose — the ways out are both
# deliberate and both leave a record: write the report, or have the owner mark the row
# WONTFIX with a reason and a date. Either edits PENDING.md, and a commit that edits
# PENDING.md is allowed through.
#
# The decision lives in ONE place — tools/postmortem-guard/check.js --gate. This hook asks
# it and relays the answer; it does not parse the ledger itself when Node can run.
#
# It used to. The inlined awk read the status column by position and its output flowed
# straight into `[ "$COUNT" -gt 0 ]`, so an unreadable ledger yielded an empty string, the
# test silently evaluated false, and a commit with outstanding debt was allowed. A ledger
# whose table had lost a column did the same. The Node layer refused both correctly the
# whole time — two runtimes holding one rule gave two different answers, and the one with
# the power to block held the wrong one. Report #0003.
#
# Node missing is the only case that falls back to shell, and that fallback is itself
# fail-closed: ledger_open_count.sh prints a bare integer or REFUSE, never "0" for a
# ledger it could not read.
LEDGER="$ROOT/docs/post-mortem/PENDING.md"
COUNTER="$ROOT/tools/postmortem-guard/ledger_open_count.sh"
GATE="$ROOT/tools/postmortem-guard/check.js"

# The exemption is for the commit that CLOSES the debt, and closing it means editing the
# LEDGER — writing the report, or recording the owner's WONTFIX. It used to match any file
# under docs/post-mortem/, so a one-character edit to README.md carried an unlimited number
# of unrelated files past the gate while the row stayed OPEN. Two flags now, because the
# question "may this commit skip the gate" and the question "does this commit need the
# folder validated" are not the same question.
TOUCHES_LEDGER=0
TOUCHES_POSTMORTEM=0
for f in "${ALL_STAGED[@]}"; do
  case "$f" in
    docs/post-mortem/PENDING.md) TOUCHES_LEDGER=1; TOUCHES_POSTMORTEM=1 ;;
    docs/post-mortem/*)          TOUCHES_POSTMORTEM=1 ;;
  esac
done

block_on_debt() {
  echo "[ols-qa pre-commit] ❌ commit BLOCKED — $1"
  echo "  เขียนรายงานให้จบก่อน หรือให้เจ้าของงานสั่ง WONTFIX พร้อมเหตุผลและวันที่"
  echo "  ทั้งสองทางแก้ที่ docs/post-mortem/PENDING.md แล้วคอมมิตนี้จะผ่านเอง"
  exit 1
}

DEBT_OPEN=""
if command -v node >/dev/null 2>&1 && [ -f "$GATE" ]; then
  GATE_OUT="$(node "$GATE" --gate 2>&1)"
  case $? in
    0) DEBT_OPEN=no ;;
    1) DEBT_OPEN=yes ;;
    *) # could not determine — say so and fall through to the shell reader, which refuses
       echo "[ols-qa pre-commit] postmortem-guard --gate could not decide; falling back:"
       printf '%s\n' "$GATE_OUT" | sed 's/^/  /' ;;
  esac
fi

if [ -z "$DEBT_OPEN" ]; then
  if [ ! -f "$COUNTER" ]; then
    block_on_debt "หาเครื่องมืออ่านบัญชีหนี้ไม่เจอ ($COUNTER) — ชั้นป้องกันหายไป"
  fi
  COUNT_OUT="$(bash "$COUNTER" "$LEDGER" 2>&1)"
  COUNT_RC=$?
  if [ "$COUNT_RC" -ne 0 ]; then
    block_on_debt "อ่านบัญชีหนี้ไม่ได้ จึงยืนยันไม่ได้ว่ามีหนี้ค้างหรือไม่ — $COUNT_OUT"
  fi
  case "$COUNT_OUT" in
    ''|*[!0-9]*) block_on_debt "ค่าที่อ่านได้จากบัญชีหนี้ไม่ใช่ตัวเลข ('$COUNT_OUT')" ;;
  esac
  if [ "$COUNT_OUT" -gt 0 ]; then DEBT_OPEN=yes; else DEBT_OPEN=no; fi
fi

if [ "$DEBT_OPEN" = "yes" ] && [ "$TOUCHES_LEDGER" -eq 0 ]; then
  echo "[ols-qa pre-commit] ❌ commit BLOCKED — post-mortem debt ค้างอยู่"
  bash "$ROOT/.claude/hooks/postmortem-debt.sh" 2>/dev/null || true
  echo "  เขียนรายงานให้จบก่อน หรือให้เจ้าของงานสั่ง WONTFIX พร้อมเหตุผลและวันที่"
  echo "  ทั้งสองทางแก้ที่ docs/post-mortem/PENDING.md แล้วคอมมิตนี้จะผ่านเอง"
  exit 1
fi

# Validate the folder whenever the commit touches it — a broken report must not land.
# Unrelated commits are not held hostage to it; CI validates the folder on every push.
#
# `--dir` points it at the snapshot, so what is judged is what will be committed.
#
# And no node is a REFUSAL, not a pass. The condition used to be
# `if [ touches ] && command -v node; then … fi` with no else, so the one path the
# exemption above already lets past the debt gate was also the path with no validation
# left on it. Every other "cannot run" in this file blocks; this one evaporated.
if [ "$TOUCHES_POSTMORTEM" -eq 1 ]; then
  if ! command -v node >/dev/null 2>&1; then
    echo "[ols-qa pre-commit] ❌ commit BLOCKED — ไม่มี node จึงตรวจรายงานไม่ได้"
    echo "  คอมมิตนี้แตะ docs/post-mortem/ ซึ่งต้องผ่านตัวตรวจก่อนเสมอ"
    echo "  ตรวจไม่ได้ ไม่เท่ากับ ตรวจแล้วผ่าน"
    exit 1
  fi
  if ! node "$ROOT/tools/postmortem-guard/check.js" --dir "$SNAP/docs/post-mortem"; then
    echo "[ols-qa pre-commit] ❌ commit BLOCKED — postmortem-guard พบปัญหาในรายงาน/บัญชีหนี้"
    exit 1
  fi
fi

exit 0
