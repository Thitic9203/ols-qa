#!/bin/bash
# ols-qa pre-push — ครึ่งฟีเจอร์ต้องไม่ขึ้นสาขาหลัก
#
# CI จับเทสต์แดงได้ก็จริง แต่จับได้ "หลัง" ของขึ้นไปแล้ว 2026-09-05 พิสูจน์ว่าราคานั้นแพงจริง:
# ชั้นตัดสินของ investigation-guard ขึ้น main โดยไม่มี hook ตามไปด้วย เทสต์ที่ผูก wiring ไว้
# จึงแดงบน main อยู่พักหนึ่ง และใครที่ clone ไประหว่างนั้นได้การ์ดที่ไม่ทำงาน
#
# 🔴 เทสต์รันบน "commit ที่กำลังจะ push" ไม่ใช่บน working tree — worktree นี้มีหลาย session
# ทำงานพร้อมกัน ไฟล์ค้างของคนอื่นจึงทำให้เทสต์แดงด้วยเรื่องที่ไม่เกี่ยวกับสิ่งที่กำลัง push
# (และแย่กว่านั้น: อาจเขียวทั้งที่ commit จริงพัง) ตรวจ tree ที่จะขึ้นเท่านั้นถึงจะตอบถูก
#
# fail closed: รันไม่ได้ = ไม่ให้ push · gate ที่รันไม่ได้ ไม่ใช่ gate ที่ผ่าน
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO='0000000000000000000000000000000000000000'

if ! command -v node >/dev/null 2>&1; then
  echo "[ols-qa pre-push] ❌ ไม่มี node — รันชุดเทสต์ไม่ได้ push ถูกบล็อก (fail-closed)"
  exit 1
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha>
SHAS=()
while read -r _lref lsha _rref _rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "$lsha" = "$ZERO" ] && continue      # การลบ ref ไม่มีอะไรให้เทสต์
  SHAS+=("$lsha")
done

[ "${#SHAS[@]}" -gt 0 ] || exit 0

TMP="$(mktemp -d)"
cleanup() { git worktree remove --force "$TMP/wt" >/dev/null 2>&1 || true; rm -rf "$TMP"; }
trap cleanup EXIT

for sha in "${SHAS[@]}"; do
  if ! git worktree add --detach --quiet "$TMP/wt" "$sha" >/dev/null 2>&1; then
    echo "[ols-qa pre-push] ❌ กาง worktree ของ $sha ไม่ได้ — ตรวจไม่ได้ = ไม่ให้ push"
    exit 1
  fi

  echo "[ols-qa pre-push] รันชุดเทสต์บน ${sha:0:8} …"
  rc=0
  found=0
  shopt -s nullglob
  for t in "$TMP"/wt/tools/*/*.test.js; do
    found=$((found + 1))
    if ! ( cd "$TMP/wt" && node "$t" >"$TMP/out" 2>&1 ); then
      rc=1
      echo "  ❌ $(basename "$(dirname "$t")")/$(basename "$t")"
      grep -E '^FAIL' "$TMP/out" | head -5 | sed 's/^/     /'
    fi
  done
  shopt -u nullglob

  git worktree remove --force "$TMP/wt" >/dev/null 2>&1 || true

  # "ไม่มีเทสต์ให้รัน" ไม่เท่ากับ "เทสต์ผ่าน" — nullglob ทำให้ลูปไม่ทำงานเลยเมื่อไม่เจอไฟล์
  # rc จึงยังเป็น 0 แล้ว gate พิมพ์ว่าเขียวทับ commit ที่มันไม่เคยวัดอะไรเลย (พิสูจน์กับ
  # commit จริงในประวัติ: ผ่าน 0 ชุด exit 0). CI มีด่านนี้อยู่แล้วในไฟล์ tests.yml
  # ส่วน gate ที่บล็อก push กลับไม่มี ทั้งที่หัวไฟล์ประกาศตัวว่า fail closed
  if [ "$found" -eq 0 ]; then
    echo "[ols-qa pre-push] ❌ push ถูกบล็อก — ไม่พบไฟล์เทสต์ใน commit ${sha:0:8} เลยสักไฟล์"
    echo "  ไม่มีอะไรให้วัด ไม่เท่ากับวัดแล้วผ่าน — gate ที่ไม่ได้วัดจะไม่บอกว่าเขียว"
    echo "  ถ้าชุดเทสต์ถูกย้ายที่จริง ให้แก้ path ใน hook นี้และใน .github/workflows/tests.yml พร้อมกัน"
    exit 1
  fi

  if [ "$rc" -ne 0 ]; then
    echo "[ols-qa pre-push] ❌ push ถูกบล็อก — commit ${sha:0:8} เทสต์ไม่ผ่าน"
    echo "  แก้ที่ต้นเหตุแล้วคอมมิตใหม่ ห้าม --no-verify"
    echo "  ถ้าเทสต์แดงเพราะฟีเจอร์ขึ้นไปครึ่งเดียว ให้คอมมิตส่วนที่ขาดให้ครบก่อน"
    exit 1
  fi
done

# บอกจำนวนชุดที่รันจริงเสมอ ไม่ใช่แค่เครื่องหมายถูก — ตัวเลขที่หายไปหรือหดลงผิดปกติ
# คือสัญญาณเดียวที่คนเห็นได้ว่า gate เริ่มวัดน้อยลง ก่อนที่มันจะวัดไม่ได้เลย
echo "[ols-qa pre-push] ✅ ชุดเทสต์เขียวบนทุก commit ที่จะ push ($found ชุดต่อ commit)"
exit 0
